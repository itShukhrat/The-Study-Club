# ============================================================
#  STUDY CLUB — environment
#  Copy to `.env.local` and fill in. The site runs without these
#  (design-preview mode); add them to enable real accounts.
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser) — for admin/seed scripts
SUPABASE_SERVICE_ROLE_KEY=

# Optional — AI coach (Anthropic). Leave blank to use the built-in coach lines.
ANTHROPIC_API_KEY=

# Optional — analytics
NEXT_PUBLIC_GA_ID=
