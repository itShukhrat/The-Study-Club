# ============================================================
#  STUDY CLUB — environment
#  Copy to `.env.local` and fill in. The site runs without these
#  (design-preview mode); add them to switch on real features.
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only: analytics ingest + insights

# Supabase Management API — provisioning only (apply schema, set auth config).
# Not used by the running app. Generate at supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Resend — transactional email. Also set as Supabase SMTP so all auth emails
# (signup code, recovery, email change) send through your verified domain.
RESEND_API_KEY=
EMAIL_FROM=Study Club <no-reply@studyclub.uz>   # must be a Resend-verified sender
EMAIL_INTERNAL_TO=contact@StudyClub.uz           # team inbox for new-member alerts

# DeepSeek — AI coach + question explanations (/api/coach, /api/explain)
DEEPSEEK_API_KEY=

# Desmos — graphing calculator (public demo key works if blank)
NEXT_PUBLIC_DESMOS_API_KEY=

# Who can open /dashboard/insights (comma-separated emails)
ADMIN_EMAILS=

# Optional — analytics
NEXT_PUBLIC_GA_ID=
