# ============================================================
#  STUDY CLUB — environment
#  Copy to `.env.local` and fill in. The site runs without these
#  (design-preview mode); add them to switch on real features.
# ============================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser) — for admin/seed scripts
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek — powers the AI coach + question explanations (/api/coach, /api/explain)
DEEPSEEK_API_KEY=

# Desmos graphing calculator — get your own at desmos.com/my-api
# (the public demo key works out of the box if you leave this blank)
NEXT_PUBLIC_DESMOS_API_KEY=

# Optional — analytics
NEXT_PUBLIC_GA_ID=
